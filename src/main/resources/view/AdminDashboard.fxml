<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Tableau de bord administrateur.

    Les modules de gestion étaient auparavant des boutons dispersés en bas de
    page, sur deux rangées mal alignées. Ils forment désormais une barre
    latérale : liste verticale, largeur fixe, ordre stable d'un écran à
    l'autre — l'œil retrouve toujours le même bouton au même endroit.

    Les indicateurs occupent la zone principale et restent cliquables.
-->
<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminDashboardController"
            styleClass="root">

   <!-- ============================================================
        BARRE LATÉRALE — modules de gestion
        ============================================================ -->
   <left>
      <VBox fx:id="barreLaterale" styleClass="barre-laterale" spacing="6" minWidth="264" prefWidth="264">
         <padding>
            <Insets top="18" right="14" bottom="18" left="14"/>
         </padding>
         <children>
            <Label text="MODULES" styleClass="barre-laterale-titre"/>

            <Button fx:id="gestionStockButton"
                    text="Gestion de Stock"
                    onAction="#handleGestionStock"
                    styleClass="bouton-lateral"
                    maxWidth="Infinity"/>

            <Button fx:id="gestionUtilisateursButton"
                    text="Gestion Utilisateurs"
                    onAction="#handleGestionUtilisateurs"
                    styleClass="bouton-lateral"
                    maxWidth="Infinity"/>

            <Button fx:id="gestionVentesButton"
                    text="Gestion des Ventes"
                    onAction="#handleGestionVentes"
                    styleClass="bouton-lateral"
                    maxWidth="Infinity"/>

            <Button fx:id="gestionTabacButton"
                    text="Caisse Tabac"
                    onAction="#handleGestionTabac"
                    styleClass="bouton-lateral"
                    maxWidth="Infinity"/>

            <Button fx:id="visualisationProduitsButton"
                    text="Visualisation Produits"
                    onAction="#handleVisualisationProduits"
                    styleClass="bouton-lateral"
                    maxWidth="Infinity"/>

            <Separator/>

            <Label text="SUIVI" styleClass="barre-laterale-titre"/>

            <Button fx:id="auditButton"
                    text="Journal d'audit"
                    onAction="#handleAudit"
                    styleClass="bouton-lateral"
                    maxWidth="Infinity"/>

            <!-- Repousse la déconnexion en bas : elle ne doit pas voisiner
                 avec les modules, où un appui accidentel fermerait la session. -->
            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="deconnexionButton"
                    text="Déconnexion"
                    onAction="#handleDeconnexion"
                    styleClass="bouton-lateral, bouton-lateral-sortie"
                    maxWidth="Infinity"/>
         </children>
      </VBox>
   </left>

   <!-- ============================================================
        ZONE PRINCIPALE — indicateurs
        ============================================================ -->
   <center>
      <ScrollPane fitToWidth="true" styleClass="zone-principale">
         <content>
            <VBox spacing="18">
               <padding>
                  <Insets top="22" right="26" bottom="26" left="26"/>
               </padding>
               <children>
                  <Label fx:id="welcomeLabel" text="Tableau de bord" styleClass="titre"/>
                  <Label text="Appuyez sur un indicateur pour en voir le détail."
                         styleClass="sous-titre"/>

                  <!-- FlowPane : les cartes se réorganisent selon la largeur
                       disponible, au lieu de déborder sur un écran étroit. -->
                  <FlowPane hgap="16" vgap="16">
                     <children>
                        <VBox fx:id="carteProduits" alignment="CENTER_LEFT" spacing="6"
                              styleClass="dashboard-stat-card" minWidth="228">
                           <children>
                              <Label text="Produits en stock" styleClass="dashboard-stat-title"/>
                              <Label fx:id="totalProduitsStatLabel" text="0" styleClass="dashboard-stat-value"/>
                              <Label text="Articles disponibles" styleClass="sous-titre"/>
                           </children>
                        </VBox>

                        <VBox fx:id="carteRuptures" alignment="CENTER_LEFT" spacing="6"
                              styleClass="dashboard-stat-card" minWidth="228">
                           <children>
                              <Label text="Ruptures" styleClass="dashboard-stat-title"/>
                              <Label fx:id="rupturesStatLabel" text="0" styleClass="dashboard-stat-value-warning"/>
                              <Label text="Produits à réapprovisionner" styleClass="sous-titre"/>
                           </children>
                        </VBox>

                        <VBox fx:id="carteVentes" alignment="CENTER_LEFT" spacing="6"
                              styleClass="dashboard-stat-card" minWidth="228">
                           <children>
                              <Label text="Ventes aujourd'hui" styleClass="dashboard-stat-title"/>
                              <Label fx:id="ventesJourStatLabel" text="0 DT" styleClass="dashboard-stat-value-accent"/>
                              <Label text="Chiffre d'affaires du jour" styleClass="sous-titre"/>
                           </children>
                        </VBox>

                        <VBox fx:id="carteFournisseurs" alignment="CENTER_LEFT" spacing="6"
                              styleClass="dashboard-stat-card" minWidth="228">
                           <children>
                              <Label text="Fournisseurs" styleClass="dashboard-stat-title"/>
                              <Label fx:id="totalFournisseursLabel" text="0" styleClass="dashboard-stat-value"/>
                              <Label text="Total fournisseurs" styleClass="sous-titre"/>
                           </children>
                        </VBox>

                        <VBox fx:id="carteCredits" alignment="CENTER_LEFT" spacing="6"
                              styleClass="dashboard-stat-card" minWidth="228">
                           <children>
                              <Label text="Crédits totaux" styleClass="dashboard-stat-title"/>
                              <Label fx:id="totalCreditsLabel" text="0 DT" styleClass="dashboard-stat-value-accent"/>
                              <Label text="Crédits fournisseurs" styleClass="sous-titre"/>
                           </children>
                        </VBox>

                        <VBox fx:id="cartePaiements" alignment="CENTER_LEFT" spacing="6"
                              styleClass="dashboard-stat-card" minWidth="228">
                           <children>
                              <Label text="Paiements aujourd'hui" styleClass="dashboard-stat-title"/>
                              <Label fx:id="paiementsJourLabel" text="0 DT" styleClass="dashboard-stat-value-warning"/>
                              <Label text="Sorties de caisse" styleClass="sous-titre"/>
                           </children>
                        </VBox>

                        <VBox fx:id="carteNotes" alignment="CENTER_LEFT" spacing="6"
                              styleClass="dashboard-stat-card" minWidth="228">
                           <children>
                              <Label text="Notes aujourd'hui" styleClass="dashboard-stat-title"/>
                              <Label fx:id="notesJourLabel" text="0" styleClass="dashboard-stat-value"/>
                              <Label text="Notes enregistrées" styleClass="sous-titre"/>
                           </children>
                        </VBox>
                     </children>
                  </FlowPane>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>

</BorderPane>
