<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane styleClass="root dashboard-root" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminDashboardController">

   <children>
      <!-- Semi-transparent overlay for better readability and clarity -->
      <AnchorPane  AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" mouseTransparent="true" />
      
      <VBox spacing="20"
            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0">

         <!-- HEADER -->
         <HBox alignment="CENTER_LEFT" spacing="15" styleClass="dashboard-header">
            <children>
               <Label fx:id="welcomeLabel"
                      text="Bienvenue, Admin"
                      styleClass="dashboard-header-label" />
               <Region HBox.hgrow="ALWAYS" />
               <Button fx:id="deconnexionButton"
                       text="🚪 Déconnexion"
                       onAction="#handleDeconnexion"
                       styleClass="dashboard-logout-button" />
            </children>
         </HBox>

         <Separator/>

         <!-- DASHBOARD CONTENT -->
         <VBox alignment="CENTER" spacing="30" VBox.vgrow="ALWAYS" style="-fx-padding: 30">
            <children>

               <Label text="🏢 Dashboard Administrateur"
                      styleClass="dashboard-title"
                      textAlignment="CENTER" />

               <VBox alignment="CENTER" spacing="30" styleClass="dashboard-container">
                  <children>
                     <Label text="📊 Modules de Gestion" styleClass="dashboard-section-title" />
                     
                     <HBox alignment="CENTER" spacing="20">
                        <children>
                           <VBox fx:id="carteProduits" alignment="CENTER_LEFT" spacing="8" styleClass="dashboard-stat-card">
                              <children>
                                 <Label text="📦 Produits en stock" styleClass="dashboard-stat-title" />
                                 <Label fx:id="totalProduitsStatLabel" text="0" styleClass="dashboard-stat-value" />
                                 <Label text="Articles disponibles" styleClass="dashboard-stat-subtitle" />
                              </children>
                           </VBox>
                           
                           <VBox fx:id="carteRuptures" alignment="CENTER_LEFT" spacing="8" styleClass="dashboard-stat-card">
                              <children>
                                 <Label text="⚠️ Ruptures" styleClass="dashboard-stat-title" />
                                 <Label fx:id="rupturesStatLabel" text="0" styleClass="dashboard-stat-value-warning" />
                                 <Label text="Produits à réapprovisionner" styleClass="dashboard-stat-subtitle" />
                              </children>
                           </VBox>
                           
                           <VBox fx:id="carteVentes" alignment="CENTER_LEFT" spacing="8" styleClass="dashboard-stat-card">
                              <children>
                                 <Label text="💰 Ventes aujourd'hui" styleClass="dashboard-stat-title" />
                                 <Label fx:id="ventesJourStatLabel" text="0 DT" styleClass="dashboard-stat-value-accent" />
                                 <Label text="Chiffre d'affaires du jour" styleClass="dashboard-stat-subtitle" />
                              </children>
                           </VBox>
                           
                           <VBox fx:id="carteFournisseurs" alignment="CENTER_LEFT" spacing="8" styleClass="dashboard-stat-card">
                              <children>
                                 <Label text="🏢 Fournisseurs" styleClass="dashboard-stat-title" />
                                 <Label fx:id="totalFournisseursLabel" text="0" styleClass="dashboard-stat-value" />
                                 <Label text="Total fournisseurs" styleClass="dashboard-stat-subtitle" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>
                     
                     <HBox alignment="CENTER" spacing="20">
                        <children>
                           <VBox fx:id="carteCredits" alignment="CENTER_LEFT" spacing="8" styleClass="dashboard-stat-card">
                              <children>
                                 <Label text="💳 Crédits totaux" styleClass="dashboard-stat-title" />
                                 <Label fx:id="totalCreditsLabel" text="0 DT" styleClass="dashboard-stat-value-accent" />
                                 <Label text="Crédits fournisseurs" styleClass="dashboard-stat-subtitle" />
                              </children>
                           </VBox>
                           
                           <VBox fx:id="cartePaiements" alignment="CENTER_LEFT" spacing="8" styleClass="dashboard-stat-card">
                              <children>
                                 <Label text="💸 Paiements aujourd'hui" styleClass="dashboard-stat-title" />
                                 <Label fx:id="paiementsJourLabel" text="0 DT" styleClass="dashboard-stat-value-warning" />
                                 <Label text="Sorties de caisse" styleClass="dashboard-stat-subtitle" />
                              </children>
                           </VBox>
                           
                           <VBox fx:id="carteNotes" alignment="CENTER_LEFT" spacing="8" styleClass="dashboard-stat-card">
                              <children>
                                 <Label text="📝 Notes aujourd'hui" styleClass="dashboard-stat-title" />
                                 <Label fx:id="notesJourLabel" text="0" styleClass="dashboard-stat-value" />
                                 <Label text="Notes enregistrées" styleClass="dashboard-stat-subtitle" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>
                     
                     <HBox alignment="CENTER" spacing="30" styleClass="dashboard-buttons-container">
                        <children>

                           <!-- GESTION STOCK -->
                           <VBox alignment="CENTER" spacing="12">
                              <children>
                                 <Button fx:id="gestionStockButton"
                                         text="📦 Gestion de Stock"
                                         onAction="#handleGestionStock"
                                         styleClass="dashboard-button dashboard-button-primary" />
                                 <Label text="Gérer les produits et le stock" 
                                        styleClass="dashboard-button-label"
                                        textAlignment="CENTER" 
                                        wrapText="true" 
                                        maxWidth="350" />
                              </children>
                           </VBox>

                           <!-- GESTION UTILISATEURS -->
                           <VBox alignment="CENTER" spacing="12">
                              <children>
                                 <Button fx:id="gestionUtilisateursButton"
                                         text="👥 Gestion Utilisateurs"
                                         onAction="#handleGestionUtilisateurs"
                                         styleClass="dashboard-button dashboard-button-accent" />
                                 <Label text="Gérer les utilisateurs" 
                                        styleClass="dashboard-button-label"
                                        textAlignment="CENTER" 
                                        wrapText="true" 
                                        maxWidth="350" />
                              </children>
                           </VBox>

                           <!-- GESTION DES VENTES -->
                           <VBox alignment="CENTER" spacing="12">
                              <children>
                                 <Button fx:id="gestionVentesButton"
                                         text="💰 Gestion des Ventes"
                                         onAction="#handleGestionVentes"
                                         styleClass="dashboard-button dashboard-button-warning" />
                                 <Label text="Consulter les ventes" 
                                        styleClass="dashboard-button-label"
                                        textAlignment="CENTER" 
                                        wrapText="true" 
                                        maxWidth="350" />
                              </children>
                           </VBox>

                           <!-- GESTION TABAC -->
                           <VBox alignment="CENTER" spacing="12">
                              <children>
                                 <Button fx:id="gestionTabacButton"
                                         text="🚬 Caisse Tabac"
                                         onAction="#handleGestionTabac"
                                         styleClass="dashboard-button dashboard-button-purple" />
                                 <Label text="Ventes Tabac/Puff/Terrea" 
                                        styleClass="dashboard-button-label"
                                        textAlignment="CENTER" 
                                        wrapText="true" 
                                        maxWidth="350" />
                              </children>
                           </VBox>

                           <!-- VISUALISATION PRODUITS -->
                           <VBox alignment="CENTER" spacing="12">
                              <children>
                                 <Button fx:id="visualisationProduitsButton"
                                         text="👁️ Visualisation Produits"
                                         onAction="#handleVisualisationProduits"
                                         styleClass="dashboard-button dashboard-button-cyan" />
                                 <Label text="Voir tous les produits"
                                        styleClass="dashboard-button-label"
                                        textAlignment="CENTER"
                                        wrapText="true"
                                        maxWidth="350" />

                                 <!-- Journal d'audit : qui a modifié quoi, et quand.
                                      Les données existaient déjà, aucun écran ne
                                      permettait de les consulter. -->
                                 <Button fx:id="auditButton"
                                         text="🗒 Journal d'audit"
                                         onAction="#handleAudit"
                                         styleClass="dashboard-button dashboard-button-cyan" />
                                 <Label text="Historique des actions (ajout, modification, suppression)"
                                        styleClass="dashboard-button-label"
                                        textAlignment="CENTER"
                                        wrapText="true"
                                        maxWidth="350" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>
                  </children>
               </VBox>
            </children>

            <padding>
               <Insets top="20" bottom="20" left="20" right="20"/>
            </padding>
         </VBox>

      </VBox>
   </children>
</AnchorPane>
